{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits",
    "local>revog/my-k8s-homelab//.renovate/autoMerge.json5",
    "local>revog/my-k8s-homelab//.renovate/changelogs.json5",
    "local>revog/my-k8s-homelab//.renovate/groups.json5",
    "local>revog/my-k8s-homelab//.renovate/labels.json5",
    "github>home-operations/renovate-presets//apps/grafanaDashboards.json5#8.1.0",
    "github>home-operations/renovate-presets//apps/searxng.json5#8.1.0",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#8.1.0"
  ],
  "timezone": "Europe/Zurich",
  "dependencyDashboardTitle": "Renovate Dashboard 🤖",
  "ignorePaths": [
    "**/*.sops.*",
    "**/resources/**",
    ".codex/**"
  ],
  "flux": {
    "managerFilePatterns": ["/\\.yaml$/"]
  },
  "helm-values": {
    "managerFilePatterns": ["/\\.yaml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/\\.yaml$/"]
  }
}
