{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits",
    "github>home-operations/renovate-presets#12.0.0",
    "github>home-operations/renovate-presets//apps/grafanaDashboards.json5#12.0.0",
    "github>home-operations/renovate-presets//apps/searxng.json5#12.0.0",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#12.0.0",
    "github>revog/my-k8s-homelab//.renovate/autoMerge.json5",
    "github>revog/my-k8s-homelab//.renovate/changelogs.json5",
    "github>revog/my-k8s-homelab//.renovate/customManagers.json5",
    "github>revog/my-k8s-homelab//.renovate/groups.json5",
    "github>revog/my-k8s-homelab//.renovate/labels.json5",
    "github>revog/my-k8s-homelab//.renovate/semanticCommits.json5"
  ],
  "timezone": "Europe/Zurich",
  "dependencyDashboard": {
    "title": "Renovate Dashboard 🤖"
  },
  "ignorePaths": [
    "**/.archive/**",
    "**/*.sops.*",
    ".codex/**"
  ],
}
