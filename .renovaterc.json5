{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits",
    "github>home-operations/renovate-presets#10.0.1",
    "github>home-operations/renovate-presets//apps/grafanaDashboards.json5#10.0.1",
    "github>home-operations/renovate-presets//apps/searxng.json5#10.0.1",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#10.0.1",
    "github>revog/my-k8s-homelab//.renovate/autoMerge.json5",
    "github>revog/my-k8s-homelab//.renovate/changelogs.json5",
    "github>revog/my-k8s-homelab//.renovate/docs.json5",
    "github>revog/my-k8s-homelab//.renovate/groups.json5",
    "github>revog/my-k8s-homelab//.renovate/labels.json5",
    "github>revog/my-k8s-homelab//.renovate/semanticCommits.json5"
  ],
  "timezone": "Europe/Zurich",
  "dependencyDashboardTitle": "Renovate Dashboard 🤖",
  "ignorePaths": [
    "**/*.sops.*",
    ".codex/**"
  ],
}
