version: v1alpha1
machine:
    certSANs:
        - 192.168.100.50     # add extra certificate SAN to machine cert for VIP adress
    features:
        diskQuotaSupport: true
        rbac: true
    kubelet:
        image: ghcr.io/siderolabs/kubelet:v1.37.1
        extraMounts:
            - destination: /var/mnt/nvme
              type: bind
              source: /var/mnt/nvme
              options:
                - bind
                - rshared
                - rw
        extraConfig:
            serializeImagePulls: false
        defaultRuntimeSeccompProfileEnabled: true
        disableManifestsDirectory: true
cluster:
    etcd:
        advertisedSubnets:
            - 192.168.100.0/24                       # Restricts etcd peer communication to this specific private LAN subnet
        extraArgs:
            auto-compaction-retention: "1"
            listen-metrics-urls: http://0.0.0.0:2381 # Exposes the etcd metrics endpoint on all interfaces for monitoring tools
---
apiVersion: v1alpha1
kind: CRICustomizationConfig
name: containerd
content: |
    [plugins."io.containerd.cri.v1.images"]
      discard_unpacked_layers = false                 # Keeps unpacked image layers to allow image reuse and exports
    [plugins."io.containerd.cri.v1.runtime"]
      device_ownership_from_security_context = true   # Grants container device access based on Pod SecurityContext settings
---
apiVersion: v1alpha1
kind: DiscoveryServiceConfig
name: default
endpoint: https://discovery.talos.dev/
---
apiVersion: v1alpha1
kind: EtcFileConfig
name: nfs.conf
mode: 420
contents: |
    [nfsrahead]
    nfs4=16384      # Sets read-ahead buffer to 16MB for NFSv4 to boost sequential read speeds
    default=128     # Falls back to a 128KB read-ahead buffer for older NFS versions
---
apiVersion: v1alpha1
kind: EtcFileConfig
name: nfsmount.conf
mode: 420
contents: |
    [ NFSMount_Global_Options ]
    nfsvers=4.1     # Enforces NFS version 4.1 for modern features and performance
    hard=True       # Enables hard mounts so operations retry indefinitely if the server drops
    nconnect=4      # Opens 4 parallel TCP connections to maximize network throughput
    noatime=True    # Disables access time updates on reads to eliminate redundant write overhead
    rsize=1048576   # Sets the maximum read block size to 1MB to minimize network packets
    wsize=1048576   # Sets the maximum write block size to 1MB for faster data transfers
---
apiVersion: v1alpha1
kind: FilesystemTrimConfig
interval: 168h0m0s
---
apiVersion: v1alpha1
kind: FilesystemScrubConfig
interval: 168h0m0s
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: nvme_tcp         # Enables NVMe over Fabrics using TCP to mount remote high-speed storage over the network (Longhorn)
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: vfio_pci         # PCI Passthrough (VFIO) to detach devices like the integrated Intel iGPU from the host and pass them directly to Kubernetes pods
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: uio_pci_generic  # Provides a generic Userspace I/O driver often required by high-performance networking or custom hardware access layers (like DPDK)
---
apiVersion: v1alpha1
kind: KubeAPIServerConfig
certExtraSANs:
    - 192.168.100.50
    - 192.168.100.51
    - 192.168.100.52
    - 192.168.100.53
    - node01
    - node02
    - node03
extraArgs:
    enable-aggregator-routing: "true" # Forces the API server to route extension API requests directly to pod IPs instead of services
image: registry.k8s.io/kube-apiserver:v1.37.1
---
apiVersion: v1alpha1
kind: KubeAuthorizerConfig
name: node
type: Node
---
apiVersion: v1alpha1
kind: KubeAuthorizerConfig
name: rbac
type: RBAC
---
apiVersion: v1alpha1
kind: KubeControllerManagerConfig
extraArgs:
    bind-address: 0.0.0.0 # Configures the controller manager to listen on all network interfaces for metrics and health endpoints
image: registry.k8s.io/kube-controller-manager:v1.37.1
---
apiVersion: v1alpha1
kind: KubeClusterConfig
clusterName: homelab
endpoint: https://192.168.100.50:6443
---
apiVersion: v1alpha1
kind: KubeExternalManifestConfig
name: cilium-cni
url: https://raw.githubusercontent.com/revog/my-k8s-homelab/refs/heads/main/kubernetes/bootstrap/cilium/cilium.yaml
---
apiVersion: v1alpha1
kind: KubeExternalManifestConfig
name: flux
url: https://raw.githubusercontent.com/revog/my-k8s-homelab/refs/heads/main/kubernetes/bootstrap/flux/flux.yaml
# ---
# apiVersion: v1alpha1                         # Kubelet Config is currently disabled because the field 'extraMounts' is not supported in new multi-document configuration. Using legacy machine.kubelet instead.
# kind: KubeletConfig
# config:
#     crashLoopBackOff:
#         maxContainerRestartPeriod: 60s       # Caps the maximum backoff delay between container restarts to 60 seconds
#     imageMaximumGCAge: 168h                  # Defines the maximum age (7 days) an unused image can exist before garbage collection
#     maxParallelImagePulls: 3                 # Allows up to 3 image pulling operations to run concurrently
#     serializeImagePulls: false               # Enables simultaneous image downloads instead of queuing them one by one
#     shutdownGracePeriod: 90s                 # Sets the total time allowed for all pods to clean up during node shutdown
#     shutdownGracePeriodCriticalPods: 60s     # Reserves 60 seconds out of the total grace period specifically for system-critical pods
# defaultRuntimeSeccompProfileEnabled: true    # Enforces the default container runtime Seccomp profile globally for enhanced security
# image: ghcr.io/siderolabs/kubelet:v1.37.0    # Specifies the exact container image version used to run the Kubelet component
---
apiVersion: v1alpha1
kind: KubeNetworkConfig
dnsDomain: cluster.local   # Defines the internal primary DNS suffix used for service discovery within the cluster
podSubnets:
    - 10.244.0.0/16        # Specifies the IP address range allocated for unique pod addresses across the cluster
serviceSubnets:
    - 10.96.0.0/12         # Specifies the IP address range allocated for virtual IPs assigned to Kubernetes services
---
apiVersion: v1alpha1
kind: KubeNodeConfig
annotations:
    tuppr.home-operations.com/factory-url: "factory.talos.dev/installer"
    tuppr.home-operations.com/schematic: "58a638b8d8d134807ae4b7badca72f1a656bd17b14e8a1f6b7c252d33862f5b1"
labels:
    node-role.kubernetes.io/control-plane: "" # Standard label assigning the control-plane role to the node
nodeIP:
    # enforce using only ip of provided subnets for the kubelet
    validSubnets:
        - 192.168.100.0/24
taints: {}  # Remove taint on the node to allow scheduling of pods on control-plane nodes

---
apiVersion: v1alpha1
kind: KubeProxyConfig
enabled: false # Disables the standard Kubernetes kube-proxy component entirely
image: registry.k8s.io/kube-proxy:v1.37.1
---
apiVersion: v1alpha1
kind: KubeSchedulerConfig
config:
    profiles:
        - schedulerName: default-scheduler                # Applies these customizations to the default Kubernetes pod scheduler
          plugins:
            score:
                disabled:
                    - name: ImageLocality                 # Disables favoring nodes that already have the container image pre-cached
          pluginConfig:
            - name: PodTopologySpread
              args:
                defaultingType: List                      # Specifies that the custom constraints list below should be used as the default
                defaultConstraints:
                    - maxSkew: 1                          # Restricts the replica imbalance between nodes to a maximum difference of 1 pod
                      topologyKey: kubernetes.io/hostname # Spreads the pods evenly across individual hosts/nodes
                      whenUnsatisfiable: ScheduleAnyway   # If perfect spreading is impossible, prioritize scheduling over strict constraints
extraArgs:
    bind-address: 0.0.0.0                                 # Configures the scheduler to listen on all network interfaces for metrics and health endpoints
image: registry.k8s.io/kube-scheduler:v1.37.1
---
apiVersion: v1alpha1
kind: KubePrismConfig
port: 7445 # Sets the local port where the KubePrism internal load balancer endpoint will listen
---
apiVersion: v1alpha1
kind: KubeTalosAPIAccessConfig
allowedRoles:
    - os:admin     # Grants the highest administrative role within the Talos OS API to the allowed namespaces
allowedKubernetesNamespaces:
    - infra-tuppr  # Allows the infra-tuppr namespace to interact with the Talos API for node lifecycles
---
apiVersion: v1alpha1
kind: Layer2VIPConfig
name: 192.168.100.50
link: enp1s0
---
apiVersion: v1alpha1
kind: ResolverConfig
searchDomains:
    domains: []
    # __TBD__
hostDNS:
    enabled: true
    forwardKubeDNSToHost: true    # Requires Cilium socketLB features
    resolveMemberNames: true      # Resolve member hostnames using the host DNS resolver.
nameservers:
    - address: 192.168.100.100    # Internal nameserver
---
apiVersion: v1alpha1
kind: SysctlConfig
params:
    # Kubernetes Controller Stability
    fs.inotify.max_user_instances: "8192"           # prevent "too many open files" for k8s controllers
    fs.inotify.max_user_watches: "1048576"          # max files watched, default 8192 is too low
    user.max_user_namespaces: "11255"               # allow more user namespaces for container runtimes

    # Core Network Buffers (64MB Max for 2.5G/10G Burst)
    net.core.default_qdisc: fq                      # fair queue, pairs with BBR
    net.core.rmem_max: "67108864"                   # max socket receive buffer (64MB)
    net.core.wmem_max: "67108864"                   # max socket send buffer (64MB)

    # BBR Congestion Control & Latency Tweaks
    net.ipv4.tcp_congestion_control: bbr            # better throughput/latency than default cubic
    net.ipv4.tcp_slow_start_after_idle: "0"         # keep full throughput on briefly idle connections
    net.ipv4.tcp_fastopen: "3"                      # send data in SYN, reduces latency (client+server)
    net.ipv4.tcp_mtu_probing: "1"                   # auto MTU discovery across different networks
    net.ipv4.tcp_window_scaling: "1"                # required for buffers >64KB
    net.ipv4.tcp_notsent_lowat: "131072"            # minimum unsent bytes before sending, reduces latency on bursty connections
    net.ipv4.ping_group_range: 0 2147483647         # allow ping from any user, required for some monitoring tools

    # TCP Buffer Tuning (Min / Default / Max)
    net.ipv4.tcp_rmem: 4096 131072 67108864         # tcp receive buffer min/default/max
    net.ipv4.tcp_wmem: 4096 65536 67108864          # tcp send buffer min/default/max

    # Cilium / ARP Neighbor Table Scaling
    net.ipv4.neigh.default.gc_thresh1: "4096"       # minimum number of entries before GC starts
    net.ipv4.neigh.default.gc_thresh2: "8192"       # maximum number of entries before GC starts to aggressively reclaim
    net.ipv4.neigh.default.gc_thresh3: "16384"      # maximum number of entries before GC starts to aggressively reclaim and log warnings

    # Longhorn / SPDK Hugepages for High-Speed I/O
    vm.nr_hugepages: "2048"                         # Longhorn's Storage Performance Development Kit (SPDK) relys on hugepages for high-speed I/O operations,
---
apiVersion: v1alpha1
kind: TimeSyncConfig
ntp:
    servers:
        - 0.pool.ntp.org
        - 1.pool.ntp.org
        - 2.pool.ntp.org
        - 3.pool.ntp.org
---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
installer:
    image: factory.talos.dev/metal-installer/58a638b8d8d134807ae4b7badca72f1a656bd17b14e8a1f6b7c252d33862f5b1:v1.14.5
    # image: factory.talos.dev/installer/cbb3dc9fd96af80a2b8d6ce7c46e802d8b1f9a085cde8cf6a0444207af765ee2:v1.14.5
provisioning:
    diskSelector:
        match: disk.dev_path == "/dev/sda"
    wipe: false
