{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      matchUpdateTypes: ["major"],
      labels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      labels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      labels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      labels: ["type/digest"],
    },
    {
      matchPackagePatterns: ["crd"], 
      matchPackageNames: [], 
      addLabels: ["type/crds"],
    },
    {
      "matchDatasources": ["docker"],
      "addLabels": ["renovate/container"]
    },
    {
      "matchDatasources": ["helm"],
      "addLabels": ["renovate/helm"]
    },
    {
      "matchManagers": ["helm-values", "helmv3"],
      "addLabels": ["renovate/helm"]
    },
    {
      "description": "Overwrite labels of OCI based charts and handle them as renovate/helm",
      "matchDatasources": ["docker"],
      "matchManagers": ["helm-values", "helmv3", "flux"],
      "labels": [],
      "addLabels": ["renovate/helm"]
    },
    {
      "matchPackageNames": ["siderolabs/talos", "ghcr.io/siderolabs/**"],
      "excludePackageNames": ["ghcr.io/siderolabs/kubelet"],
      "branchTopic": "talos",
      "groupName": "talos",
      "addLabels": ["renovate/talos"]
    },
    {
      "matchPackageNames": ["ghcr.io/siderolabs/kubelet"],
      "branchTopic": "kubernetes",
      "groupName": "kubernetes",
      "addLabels": ["renovate/kubernetes"]
    },
    {
      matchManagers: ["github-actions"],
      addLabels: ["renovate/github-action"],
    },
  ],
}
