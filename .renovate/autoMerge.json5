{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Auto-merge trusted OCI digests",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["digest", "pin", "pinDigest"],
      // matchPackagePrefixes: [
      //   "ghcr.io/home-operations",
      //   "ghcr.io/bjw-s",
      //   "ghcr.io/bjw-s-labs",
      // ],
      excludePackagePatterns: [
        ":latest$",
        ":main$",
        ":master$"
      ],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: "Auto-merge patch updates for Helm and Docker",
      matchDatasources: ["docker", "helm"],
      matchUpdateTypes: ["patch"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: "Auto-merge high-cadence OCI packages weekly",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: [
        "ghcr.io/renovatebot/renovate",
        "/kube-prometheus-stack/",
      ],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
      schedule: ["before 6am on Monday"],
    },
    {
      description: "Auto-merge Grafana dashboards",
      matchDatasources: ["custom.grafana-dashboards"],
      matchUpdateTypes: ["major"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
    },
    {
      description: "Auto-merge Renovate Presets",
      matchManagers: ["renovate-config"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
    },

    // Avoid Auto-Merge
    {
      "description": "Avoid auto-merge for all major updates",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Avoid Automerge for Talos & Extension",
      "matchPackageNames": ["siderolabs/talos", "ghcr.io/siderolabs/**"],
      "excludePackagePatterns": ["kubelet", "kube-"],
      "branchTopic": "talos",
      "groupName": "talos",
      "addLabels": ["renovate/talos"],
      "automerge": false
    },
    {
      "description": "Avoid Automerge for Kubelet and other K8s components",
      "matchPackagePatterns": [
        "kubelet",
        "^registry\\.k8s\\.io\\/kube-",
        "^ghcr\\.io\\/siderolabs\\/kube-"
      ],
      "branchTopic": "kubernetes",
      "groupName": "kubernetes",
      "addLabels": ["renovate/kubernetes"],
      "automerge": false
    }
  ],
}
