{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Bootstrap component Update group",
      matchFileNames: ["**/bootstrap/**"],
      groupName: "Bootstrap Components",
      group: {
        semanticCommitType: "feat",
        semanticCommitScope: "bootstrap",
        commitMessageTopic: "update charts and images"
      }
    },
    {
      description: "Cilium (CNI, Operator, Hubble & Chart) Update group",
      groupName: "Cilium",
      // Matches both the container image registry and the Helm chart name
      matchPackageNames: ["cilium"],
      matchPackagePatterns: [
        "^quay.io/cilium/",
        "^cilium/"
      ],
      group: {
        "commitMessageTopic": "{{{groupName}}} group"
      }
    },
    {
      description: "Flux group",
      groupName: "Flux",
      // matchDatasources: ["docker"],
      matchPackagePatterns: ["^fluxcd/", "^ghcr.io/fluxcd/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Immich Update group",
      groupName: "Immich",
      matchPackagePatterns: ["immich"],
      group: {
        commitMessageTopic: "{{{groupName}}} group"
      }
    },
    {
      description: "Intel Device Plugins group",
      groupName: "intel-device-plugins",
      // matchDatasources: ["docker"],
      matchPackagePatterns: ["intel-gpu-resource-driver"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      }
    },
    {
      description: "Kubernetes group",
      groupName: "Kubernetes",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/kube-apiserver/",
        "/kube-controller-manager/",
        "/kube-proxy/",
        "/kube-scheduler/",
        "/kubelet/",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 1,
    },
    {
      description: "Prometheus (Exporter, CRDs, ...) Update group",
      groupName: "Prometheus",
      matchPackagePatterns: ["prometheus"],
      group: {
        commitMessageTopic: "{{{groupName}}} group"
      }
    },
    {
      description: "Talos Update group",
      groupName: "Talos",
      // Matches both the standard docker images and the custom factory preset from upgrades.yaml
      matchDatasources: ["docker", "custom.talos-factory"],
      matchPackageNames: [
        "siderolabs/talos",
        "ghcr.io/siderolabs/talos",
        "ghcr.io/siderolabs/installer",
        "ghcr.io/siderolabs/talosctl"
      ],
      // Enforce safe sequential updates (e.g. v1.14.0 -> v1.14.1)
      separateMajorMinor: true,
      separateMinorPatch: true,
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 1,
    },
  ],
}
