{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      description: "Process annotated docs",
      "customType": "regex",
      // Scan README.md in root directory and subdirs
      "fileMatch": ["(^|/)README\\.md$"],
      "matchStrings": [
        // Comment above line with version
        "datasource=(?<datasource>[a-z-]+?)(?: depName=(?<depName>[^\\s]+?))?(?: packageName=(?<packageName>[^\\s]+?))?\\s*\\n[A-Z0-9_]+=v?(?<currentValue>[0-9.]+(?:-[a-z0-9.]+)?)",
        // Inline comment
        "v?(?<currentValue>[0-9.]+(?:-[a-z0-9.]+)?)\\s+<!-- renovate: datasource=(?<datasource>[a-z-]+?)(?: depName=(?<depName>[^\\s]+?))?(?: packageName=(?<packageName>[^\\s]+?))? -->"
      ]
    },
    {
      description: "Process annotated dependencies",
      customType: "regex",
      managerFilePatterns: [
        "/(^|/).+\\.env(?:\\.j2)?$/",
        "/(^|/).+\\.sh(?:\\.j2)?$/",
        "/(^|/).+\\.ya?ml(?:\\.j2)?$/",
      ],
      matchStrings: [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( repository=(?<registryUrl>\\S+))?\\n.+(:\\s|=)(&\\S+\\s)?(?<currentValue>\\S+)",
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n.+/(?<currentValue>(v|\\d)[^/]+)",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
    },
  ]
}
